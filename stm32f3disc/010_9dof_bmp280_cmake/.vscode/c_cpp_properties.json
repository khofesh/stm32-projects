{
    "configurations": [
        {
            "name": "STM32F303",
            "compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": ["-mcpu=cortex-m4", "-mthumb", "-mfpu=fpv4-sp-d16", "-mfloat-abi=hard"],
            "defines": ["USE_HAL_DRIVER", "STM32F303xC"],
            "includePath": [
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Drivers/STM32F3xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/STM32F3xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F3xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Include",
                "${workspaceFolder}/Bsp/Inc",
                "${workspaceFolder}/Sensors/Inc",
                "${workspaceFolder}/Fusion/Inc",
                "${workspaceFolder}/App/Inc",
                "${workspaceFolder}/build/Debug/gen"
            ],
            "cStandard": "c11",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
}
